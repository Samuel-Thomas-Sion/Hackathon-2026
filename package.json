{
  "name": "clauseguard",
  "version": "1.0.0",
  "private": true,
  "description": "ClauseGuard — AI contract & scam fine-print auditor (Cloudflare Workers + Pages).",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 8788",
    "try-site": "node tools/try-site.mjs",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "secret:gemini": "wrangler secret put GEMINI_API_KEY",
    "lock-deck": "node tools/lock-deck.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "type": "module"
}
